{
  "name": "sproutdesk",
  "version": "1.0.0",
  "private": true,
  "description": "SproutDesk - original early-learning centre management platform (attendance, daily reports, parent communication, billing).",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/migrate.js --fresh && node src/db/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.1",
    "pg": "^8.12.0"
  }
}
