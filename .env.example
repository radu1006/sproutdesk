# ---------------------------------------------------------------------------
# SproutDesk environment configuration
# Copy this file to ".env" and adjust the values, then run "npm run migrate".
# NEVER commit the real .env file (it is already listed in .gitignore).
# ---------------------------------------------------------------------------

# Web server
PORT=3000
NODE_ENV=development

# Secret used to sign the session cookie. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-value

# How long a login stays valid, in hours.
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_CLIENT = sqlite  -> file based database, nothing to install.
# DATABASE_CLIENT = postgres -> requires a PostgreSQL server (see docs/DATABASE.md).
DATABASE_CLIENT=sqlite

# Used only when DATABASE_CLIENT=sqlite. Path to the database file,
# relative to the project root or absolute.
SQLITE_PATH=./data/sproutdesk.sqlite

# Used only when DATABASE_CLIENT=postgres.
# Either set DATABASE_URL ...
# DATABASE_URL=postgres://sproutdesk:sproutdesk@localhost:5432/sproutdesk
# ... or the individual settings below.
PGHOST=localhost
PGPORT=5432
PGDATABASE=sproutdesk
PGUSER=sproutdesk
PGPASSWORD=sproutdesk

# Set to "true" when your provider requires TLS (see docs/DATABASE.md).
PGSSL=false

# ---------------------------------------------------------------------------
# Display defaults
# ---------------------------------------------------------------------------
# Currency used for new invoices and the billing summaries. The centre can also
# change its own currency from the Settings screen (stored in the database).
DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# Uploads (class feed photos)
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------------------
# Demo seed accounts (used by "npm run seed", never by the running app)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@sproutdesk.test
SEED_ADMIN_PASSWORD=Admin123!
